{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CompanyMilestoneIngestRun",
  "description": "Local single-symbol or cross-asset research events. all-assets is a browser-local display scope.",
  "type": "object",
  "required": [
    "mode",
    "events"
  ],
  "properties": {
    "mode": {
      "type": "string",
      "const": "company-milestone"
    },
    "query": {
      "type": "object",
      "properties": {
        "symbol": {
          "type": "string"
        },
        "importTarget": {
          "enum": [
            "symbol",
            "all-assets"
          ],
          "default": "symbol"
        },
        "topic": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "externalId",
          "title",
          "content",
          "occurredAt",
          "eventType",
          "markerLabel"
        ],
        "properties": {
          "externalId": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "occurredAt": {
            "type": "string"
          },
          "datePrecision": {
            "enum": [
              "DATE",
              "DATETIME"
            ]
          },
          "importance": {
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH",
              "CRITICAL"
            ]
          },
          "scope": {
            "enum": [
              "COUNTRY",
              "INDUSTRY",
              "COMPANY",
              "CROSS"
            ]
          },
          "eventType": {
            "type": "string"
          },
          "countries": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "industries": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "assets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "markerLabel": {
            "type": "string",
            "maxLength": 16
          },
          "sourceUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "payload": {
            "type": "object",
            "required": [
              "impact"
            ],
            "properties": {
              "impact": {
                "type": "object",
                "required": [
                  "summary"
                ],
                "properties": {
                  "summary": {
                    "type": "string",
                    "minLength": 1
                  },
                  "channels": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "demand",
                        "cost",
                        "capacity",
                        "margin",
                        "narrative"
                      ]
                    }
                  }
                }
              }
            }
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "url"
              ],
              "properties": {
                "url": {
                  "type": "string"
                },
                "note": {
                  "type": "string"
                }
              }
            }
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "readingLinks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "url"
              ],
              "properties": {
                "url": {
                  "type": "string",
                  "pattern": "^https?://"
                },
                "title": {
                  "type": "string"
                },
                "note": {
                  "type": "string"
                },
                "language": {
                  "type": "string"
                }
              }
            }
          },
          "macroKeys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "persons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "institutions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "reason"
        ],
        "properties": {
          "reason": {
            "type": "string"
          },
          "hint": {
            "type": "string"
          }
        }
      }
    },
    "schemaVersion": {
      "type": "integer",
      "enum": [
        1,
        2
      ]
    },
    "pack": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "symbols": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
