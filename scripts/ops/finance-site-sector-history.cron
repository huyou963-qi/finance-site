SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# 以美东收盘后的日期记载当前分类；香港服务器本地时区不影响事实日期。
CRON_TZ=America/New_York
TZ=America/New_York
FINANCE_SITE_PATH=/opt/finance-site

# 每个美股交易日收盘后，归档 SPY 与 11 个 Sector SPDR 的官网持仓。
30 18 * * 1-5 root cd "$FINANCE_SITE_PATH" && mkdir -p logs .data && flock -n /tmp/finance-sector-etf-holdings.lock npm run equity:sync-sector-etf-holdings >> logs/sector-etf-holdings.log 2>&1

# 将当时已观察到的当前 GICS 分类记为开放有效期；变化时由 writer 关闭旧区间。
45 18 * * 1-5 root cd "$FINANCE_SITE_PATH" && mkdir -p logs .data && flock -n /tmp/finance-sector-classifications.lock npm run equity:snapshot-current-classifications >> logs/sector-classifications.log 2>&1

# 每天北京时间 19:15（美东 06:15/07:15）处理上一日公告，回看七天补漏。
# 替代原周度财报任务，不做盘中轮询；固定香港时区避免夏令时调度切换。
# 单并发、512MB heap、低 CPU 优先级；脚本默认 75 分钟预算到点自行收尾记为 partial，
# 90 分钟 timeout 仅作兜底；未完成任务留待下一批。
# filing-fallback-limit=20：财报季 companyfacts 滞后时尽量用原文 XBRL 回补；backlog 默认 120 天重收 sync-sec 留下的 null 队列。
CRON_TZ=Asia/Hong_Kong
15 19 * * * root cd "$FINANCE_SITE_PATH" && mkdir -p logs .data && flock -n /tmp/finance-sector-daily-disclosures.lock nice -n 10 timeout --signal=TERM --kill-after=30s 90m env NODE_OPTIONS=--max-old-space-size=512 npm run equity:sync-daily-disclosures -- --filing-fallback-limit=20 >> logs/sector-daily-disclosures.log 2>&1
# 第二轮（香港 11:15）：每轮最多深度处理 300 份，财报季积压与 companyfacts 滞后靠它加倍消化。
# 与 03:20 持股任务（最长到 07:20）和 19:10 量化月任务错开，避免同机并发访问 SEC。
15 11 * * * root cd "$FINANCE_SITE_PATH" && mkdir -p logs .data && flock -n /tmp/finance-sector-daily-disclosures.lock nice -n 10 timeout --signal=TERM --kill-after=30s 90m env NODE_OPTIONS=--max-old-space-size=512 npm run equity:sync-daily-disclosures -- --filing-fallback-limit=20 >> logs/sector-daily-disclosures.log 2>&1
